---
import type { Dictionary } from '../i18n/dictionary';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<section id="about" class="border-b border-grid">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">{dict.about.heading}</h2>

    <div class="mt-8 grid gap-12 lg:grid-cols-[1.2fr_1fr]">
      <p class="max-w-xl text-base leading-relaxed text-ink/90 sm:text-lg">{dict.about.paragraph}</p>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-1">
        <div>
          <h3 class="font-mono text-xs tracking-[0.15em] text-line uppercase">{dict.about.educationHeading}</h3>
          <ul class="mt-3 space-y-4">
            {
              dict.about.education.map((item) => (
                <li>
                  <p class="text-sm font-medium text-ink">{item.institution}</p>
                  {item.period && <p class="font-mono text-xs text-ink-dim">{item.period}</p>}
                  <p class="mt-0.5 text-sm text-ink/80">{item.detail}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3 class="font-mono text-xs tracking-[0.15em] text-line uppercase">{dict.about.languagesHeading}</h3>
          <ul class="mt-3 space-y-1.5 text-sm text-ink/90">
            {dict.about.languages.map((lang) => <li>{lang}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
