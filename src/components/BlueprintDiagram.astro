---
interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="not-prose">
  <div class="blueprint-grid relative overflow-hidden rounded-sm border border-[color-mix(in_oklab,var(--color-line)_35%,transparent)] bg-surface/40 p-3 sm:p-6">
    <svg
      viewBox="0 0 600 400"
      class="w-full h-auto"
      role="img"
      aria-labelledby="diagram-title"
    >
      <title id="diagram-title">{caption}</title>
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--color-line)" />
        </marker>
      </defs>

      <!-- corner sheet marks -->
      <g stroke="var(--color-line-dim)" stroke-width="1.5" fill="none">
        <path d="M8,24 V8 H24" />
        <path d="M576,8 H592 V24" />
        <path d="M592,376 V392 H576" />
        <path d="M24,392 H8 V376" />
      </g>

      <!-- connectors -->
      <g fill="none" stroke="var(--color-line)" stroke-width="2" stroke-linecap="round">
        <path pathLength="1" class="diagram-line" style="--diagram-delay:0.1s" d="M156,60 H200 V162 H228" marker-end="url(#arrow)" />
        <path pathLength="1" class="diagram-line" style="--diagram-delay:0.5s" d="M228,182 H212 V88 H156" marker-end="url(#arrow)" />
        <path pathLength="1" class="diagram-line" style="--diagram-delay:0.9s" d="M312,196 V236 H418 V246" marker-end="url(#arrow)" />
      </g>

      <!-- connector labels -->
      <g class="font-mono fill-ink-dim text-[11px] diagram-label" style="--diagram-delay:0.3s">
        <text x="164" y="52">POST /api/links</text>
        <text x="164" y="100">302 Redirect</text>
        <text x="322" y="222">EF Core → SQL</text>
      </g>

      <!-- CLIENT node -->
      <g class="diagram-node" style="--diagram-delay:0s">
        <rect x="24" y="32" width="132" height="56" rx="3" fill="var(--color-surface)" stroke="var(--color-line)" stroke-width="1.5" />
        <text x="90" y="65" text-anchor="middle" class="font-mono fill-ink text-[13px] font-medium">CLIENT</text>
      </g>

      <!-- API node -->
      <g class="diagram-node" style="--diagram-delay:0.4s">
        <rect x="228" y="132" width="152" height="64" rx="3" fill="var(--color-surface)" stroke="var(--color-line)" stroke-width="1.5" />
        <text x="304" y="169" text-anchor="middle" class="font-mono fill-ink text-[13px] font-medium">API</text>
        <path d="M304,146 h-40" stroke="var(--color-line-dim)" stroke-width="1" stroke-dasharray="2 3" />
        <text x="228" y="122" class="font-mono fill-line text-[10px]">AUTH: JWT + Identity</text>
      </g>

      <!-- DB node -->
      <g class="diagram-node" style="--diagram-delay:0.8s">
        <rect x="392" y="246" width="176" height="72" rx="10" fill="var(--color-surface)" stroke="var(--color-line)" stroke-width="1.5" />
        <text x="480" y="288" text-anchor="middle" class="font-mono fill-ink text-[13px] font-medium">SQL SERVER</text>
      </g>
    </svg>
  </div>
  <figcaption class="mt-3 font-mono text-xs text-ink-dim italic">{caption}</figcaption>
</figure>

<style>
  .diagram-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw-in 0.9s ease-out forwards;
    animation-delay: var(--diagram-delay, 0s);
  }

  .diagram-node,
  .diagram-label {
    opacity: 0;
    animation: fade-up 0.6s ease-out forwards;
    animation-delay: var(--diagram-delay, 0s);
  }

  @keyframes draw-in {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
