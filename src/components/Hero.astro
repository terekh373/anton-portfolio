---
import type { Dictionary } from '../i18n/dictionary';
import BlueprintDiagram from './BlueprintDiagram.astro';
import { CONTACT } from '../lib/contact';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<section class="blueprint-grid border-b border-grid">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:py-28">
    <div>
      <h1 class="font-display text-4xl leading-[1.05] font-bold tracking-tight text-ink sm:text-5xl lg:text-6xl">
        {dict.hero.name}
      </h1>
      <p class="mt-3 text-lg text-ink-dim sm:text-xl">{dict.hero.eyebrow} · {dict.hero.role}</p>
      <p class="mt-1 font-mono text-sm text-ink-dim">{dict.hero.location}</p>
      <p class="mt-6 max-w-prose text-base leading-relaxed text-ink/90 sm:text-lg">
        {dict.hero.tagline}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href={`mailto:${CONTACT.email}`}
          class="inline-flex items-center gap-2 rounded-sm bg-stamp px-5 py-3 font-mono text-sm font-medium text-bg transition-transform hover:-translate-y-0.5"
        >
          {dict.hero.ctaEmail}
        </a>
        <a href={CONTACT.github} target="_blank" rel="noreferrer" class="font-mono text-sm text-ink-dim transition-colors hover:text-line">
          {dict.hero.ctaGithub}
        </a>
        <a href={CONTACT.linkedin} target="_blank" rel="noreferrer" class="font-mono text-sm text-ink-dim transition-colors hover:text-line">
          {dict.hero.ctaLinkedin}
        </a>
        <a href={CONTACT.cvEn} class="font-mono text-sm text-ink-dim transition-colors hover:text-line">
          {dict.hero.ctaCv}
        </a>
      </div>
    </div>

    <BlueprintDiagram caption={dict.hero.diagramCaption} />
  </div>
</section>
